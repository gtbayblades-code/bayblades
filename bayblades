local function lc() return LP.Character end
local function lr() local c=lc() return c and c:FindFirstChild("HumanoidRootPart") end
local function lh() local c=lc() return c and c:FindFirstChildOfClass("Humanoid") end
local function isTm(p) if not F.TEAM then return false end return p.Team~=nil and p.Team==LP.Team end
local function getP(p,n) local c=p.Character return c and c:FindFirstChild(n) end
local function valid(p) if p==LP then return false end if isTm(p) then return false end local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid") return h and h.Health>0 end
local function w2s(pos) local sp,on=CAM:WorldToViewportPoint(pos) if not on or sp.Z<=0 then return nil end return Vector2.new(sp.X,sp.Y) end
local function vis(part) if not F.WALL then return true end local rp=RaycastParams.new() rp.FilterType=Enum.RaycastFilterType.Exclude rp.FilterDescendantsInstances={LP.Character,CAM} local h=WS:Raycast(CAM.CFrame.Position,part.Position-CAM.CFrame.Position,rp) return h==nil or h.Instance:IsDescendantOf(part.Parent) end
local function gP() if gethui then local ok,h=pcall(gethui) if ok and h then return h end end return CG end
local function closest() local b,bd=nil,F.FOV local c=CAM.ViewportSize/2 for _,p in ipairs(Players:GetPlayers()) do if valid(p) then local pt=getP(p,"Head") if pt then local sp=w2s(pt.Position) if sp then local d=(sp-c).Magnitude if d<bd and vis(pt) then b,bd=pt,d end end end end end return b end
RunService.RenderStepped:Connect(function() if not F.AIM or not aimHeld then return end local t=closest() if t then CAM.CFrame=CAM.CFrame:Lerp(CFrame.new(CAM.CFrame.Position,t.Position),F.SMOOTH) end end)
