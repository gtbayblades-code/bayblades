local function stopFly() if flyC then flyC:Disconnect() flyC=nil end local r=lr() local h=lh() if h then h.PlatformStand=false end if r then for _,o in ipairs(r:GetChildren()) do if o:IsA("BodyVelocity") or o:IsA("BodyGyro") then o:Destroy() end end end end
local function startFly() local h,r=lh(),lr() if not h or not r then return end h.PlatformStand=true local bv=Instance.new("BodyVelocity",r) bv.MaxForce=Vector3.new(1e5,1e5,1e5) bv.Velocity=Vector3.zero local bg=Instance.new("BodyGyro",r) bg.MaxTorque=Vector3.new(1e5,1e5,1e5) bg.P=1e4 bg.CFrame=r.CFrame flyC=RunService.RenderStepped:Connect(function() local cam=CAM.CFrame local m=Vector3.zero if UIS:IsKeyDown(Enum.KeyCode.W) then m+=cam.LookVector end if UIS:IsKeyDown(Enum.KeyCode.S) then m-=cam.LookVector end if UIS:IsKeyDown(Enum.KeyCode.A) then m-=cam.RightVector end if UIS:IsKeyDown(Enum.KeyCode.D) then m+=cam.RightVector end if UIS:IsKeyDown(Enum.KeyCode.Space) then m+=Vector3.new(0,1,0) end if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then m-=Vector3.new(0,1,0) end bv.Velocity=m.Magnitude>0 and m.Unit*F.FLYSPD or Vector3.zero end) end
local function setNC(on) if ncC then ncC:Disconnect() ncC=nil end if not on then return end ncC=RunService.Stepped:Connect(function() local c=lc() if c then for _,p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") and p.CanCollide then p.CanCollide=false end end end end) end
task.spawn(function() while true do local r=lr() if F.FLY and r and not flyC then startFly() elseif not F.FLY and flyC then stopFly() end setNC(F.NOCLIP) task.wait(0.3) end end)
