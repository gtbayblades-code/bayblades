local function rmEsp(p) local e=espObjs[p] if e then e.b:Destroy() e.tr:Destroy() espObjs[p]=nil end end
local function geEsp(p) if not espObjs[p] then espObjs[p]=mkEsp(p) end return espObjs[p] end
local function upEsp() if not F.ESP then for _,e in pairs(espObjs) do e.b.Visible=false e.tr.Visible=false end return end for _,p in ipairs(Players:GetPlayers()) do if p~=LP then local e=geEsp(p) local ch=p.Character local hrp=ch and ch:FindFirstChild("HumanoidRootPart") local hd=ch and ch:FindFirstChild("Head") local h=ch and ch:FindFirstChildOfClass("Humanoid") if ch and hrp and hd and h and h.Health>0 then local t=w2s(hd.Position+Vector3.new(0,0.8,0)) local bo=w2s(hrp.Position-Vector3.new(0,2.5,0)) if t and bo then local H=math.abs(bo.Y-t.Y) local W=H*0.55 e.b.Visible=true e.b.Position=UDim2.new(0,t.X-W/2,0,t.Y) e.b.Size=UDim2.new(0,W,0,H) e.s.Enabled=F.BOX e.g.Enabled=F.BOX e.n.Visible=F.NAME e.n.Text=p.Name e.hb.Visible=F.HP local fr=math.clamp(h.Health/h.MaxHealth,0,1) e.hh.Size=UDim2.new(1,0,fr,0) e.hh.BackgroundColor3=Color3.fromRGB(math.floor(255*(1-fr)),math.floor(255*fr),60) e.d.Visible=F.DIST local mr=lr() if mr then e.d.Text=string.format("%d",(mr.Position-hrp.Position).Magnitude) end if F.TRACER then e.tr.Visible=true local o=Vector2.new(CAM.ViewportSize.X/2,CAM.ViewportSize.Y) local tg=Vector2.new(t.X,t.Y+H/2) local df=tg-o e.tr.Position=UDim2.new(0,o.X,0,o.Y) e.tr.Size=UDim2.new(0,df.Magnitude,0,1) e.tr.Rotation=math.deg(math.atan2(df.Y,df.X)) else e.tr.Visible=false end else e.b.Visible=false e.tr.Visible=false end else e.b.Visible=false e.tr.Visible=false end end end end
