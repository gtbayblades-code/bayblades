local function avisarDiscord(usuario, key, tipo)
    local dados = {
        username = "Bayblades Logs",
        content = "**Nova entrada no hub**\n"
            .. "Usuário: `" .. usuario .. "`\n"
            .. "Key: `" .. key .. "`\n"
            .. "Tipo: `" .. tipo .. "`\n"
            .. "Horário: `" .. os.date("%Y-%m-%d %H:%M:%S") .. "`",
