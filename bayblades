local function logDiscord(u,k,t)
    if WEBHOOK=="" or WEBHOOK=="COLA_TUA_URL_AQUI" then return end
    local d={username="Bayblades Logs",content="**Entrada no hub**\nUsuário: `"..u.."`\nKey: `"..k.."`\nTipo: `"..t.."`\nHorário: `"..os.date("%Y-%m-%d %H:%M:%S").."`"}
    pcall(function() HS:PostAsync(WEBHOOK,HS:JSONEncode(d)) end)
end

local function lerReg()
    if isfile and isfile(SAVE_FILE) then
        local ok,c=pcall(readfile,SAVE_FILE)
        if ok and c then
            local ok2,d=pcall(function() return HS:JSONDecode(c) end)
            if ok2 and type(d)=="table" then return d end
        end
    end
    return {}
end
local function salvarReg(d)
    if writefile then pcall(writefile,SAVE_FILE,HS:JSONEncode(d)) end
end
local function validar(k)
    local info=KEYS[k]
    if not info then return nil,"nao existe" end
    local reg=lerReg()
    local agora=os.time()
    if not reg[k] then
        reg[k]={primeira=agora}
        salvarReg(reg)
        return info.tipo,nil
    end
    if info.horas then
        local limite=reg[k].primeira+(info.horas*3600)
        if agora>limite then return nil,"expirada" end
    end
    return info.tipo,nil
end

local function lr() local c=LP.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function lh() local c=LP.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function w2s(v) local s,o=CAM:WorldToViewportPoint(v) if not o or s.Z<=0 then return nil end return Vector2.new(s.X,s.Y) end
local function isT(p) if not F.TC then return false end return p.Team~=nil and p.Team==LP.Team end
local function getP(p,n) local c=p.Character return c and c:FindFirstChild(n) end
local function val(p) if p==LP then return false end if isT(p) then return false end local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid") return h and h.Health>0 end
local function vs(pt) if not F.WC then return true end local rp=RaycastParams.new() rp.FilterType=Enum.RaycastFilterType.Exclude rp.FilterDescendantsInstances={LP.Character,CAM} local h=WS:Raycast(CAM.CFrame.Position,pt.Position-CAM.CFrame.Position,rp) return h==nil or h.Instance:IsDescendantOf(pt.Parent) end

