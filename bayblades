local F={AIM=false,SMOOTH=0.25,FOV=120,TEAM=true,WALL=true,SHOWFOV=true,ESP=false,BOX=true,NAME=true,HP=true,DIST=true,TRACER=false,FLY=false,FLYSPD=60,SPD=false,SPDVAL=32,IJP=false,NOCLIP=false,FB=false}
